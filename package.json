{
  "name": "camari-japan-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=8192 node_modules/next/dist/bin/next dev -p 3001",
    "studio": "sanity dev --port 3001",
    "build": "next build",
    "build:cloudflare": "SITES_PREVIEW=1 opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "catalog:template": "python3 scripts/build_product_catalog.py --write-template data/import/product-catalog-template.xlsx",
    "catalog:build": "python3 scripts/build_product_catalog.py data/import/product-catalog.xlsx",
    "sanity:markets:dry-run": "sanity exec scripts/backfillProductTypeMarkets.mjs",
    "sanity:markets:migrate": "sanity exec scripts/backfillProductTypeMarkets.mjs -- --commit",
    "netsuite:newsletter:smoke": "node scripts/smoke-test-newsletter.mjs",
    "netsuite:inquiry:smoke": "node scripts/smoke-test-inquiry.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/fiber": "^9.6.1",
    "@sanity/client": "^7.11.0",
    "@sanity/image-url": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "hls.js": "^1.6.16",
    "lenis": "^1.3.23",
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "next-sanity": "^10.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^4.0.0",
    "styled-components": "^6.1.13",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^4.114.0"
  }
}
